---

<!doctype html>
<html lang="nl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Persoonlijke website van een creatieve, resultaatgerichte developer in opleiding."
    />

    <meta name="theme-color" content="#16231d" />

    <title>Mijn ontwikkelprofiel</title>

    <!-- Tailwind Play CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <style type="text/tailwindcss">
      @theme {
        --color-dark: #16231d;
        --color-light: #f7f5ed;
        --color-green: #d8f75a;
        --color-orange: #ff6945;
        --color-line: #c9c9bb;
        --color-gray: #59645d;
      }
    </style>
  </head>

  <body class="m-0 bg-light text-dark font-[Arial,sans-serif]">
    <header
      class="site-header flex h-[70px] items-center justify-between border-b border-line px-[8%]"
    >
      <a
        class="text-[14px] font-bold text-dark no-underline transition-opacity hover:opacity-60 max-[560px]:text-[11px]"
        href="#top"
      >
        [ ILKER OCAK ]
      </a>

      <nav
        aria-label="Hoofdnavigatie"
        class="flex gap-6 max-[900px]:gap-[13px] max-[560px]:gap-2"
      >
        <a
          class="text-[14px] font-bold text-dark no-underline hover:underline max-[900px]:text-[12px] max-[560px]:text-[11px]"
          href="#profiel"
        >
          Profiel
        </a>

        <a
          class="text-[14px] font-bold text-dark no-underline hover:underline max-[900px]:text-[12px] max-[560px]:text-[11px]"
          href="#sterktes"
        >
          Sterktes
        </a>

        <a
          class="text-[14px] font-bold text-dark no-underline hover:underline max-[900px]:text-[12px] max-[560px]:text-[11px]"
          href="#onderzoek"
        >
          Onderzoek
        </a>

        <a
          class="text-[14px] font-bold text-dark no-underline hover:underline max-[900px]:text-[12px] max-[560px]:text-[11px]"
          href="#plan"
        >
          Plan
        </a>
      </nav>
    </header>

    <main id="top">
      <!-- HERO -->
      <section
        class="relative isolate grid min-h-[calc(100vh-70px)] grid-cols-[minmax(0,1fr)_minmax(240px,320px)] items-center gap-[50px] overflow-hidden border-b border-line px-[12%] py-[100px] max-[900px]:grid-cols-[minmax(0,1fr)_220px] max-[900px]:gap-[25px] max-[900px]:px-5 max-[900px]:py-[65px] max-[900px]:min-h-[620px] max-[560px]:grid-cols-1 max-[560px]:gap-8 max-[560px]:py-[50px]"
      >
        <div
          class="absolute right-[5%] bottom-[9%] -z-10 h-[340px] w-[340px] rounded-full bg-green max-[900px]:right-0 max-[900px]:h-[250px] max-[900px]:w-[250px] max-[560px]:right-[-50px] max-[560px]:bottom-[35px]"
          aria-hidden="true"
        ></div>

        <div>
          <p
            class="mb-4 text-[12px] font-bold uppercase tracking-[1px] text-gray"
          >
            Ilker Ocak · Developer in opleiding · Rotterdam
          </p>

          <h1
            class="mb-7 max-w-[700px] text-[clamp(56px,8vw,120px)] font-bold leading-[0.9] tracking-[-5px] max-[900px]:text-[58px] max-[900px]:tracking-[-3px]"
          >
            Ik bouw ideeën<br />
            <em class="not-italic text-orange">met aandacht.</em>
          </h1>

          <p
            class="mb-0 max-w-[600px] text-[18px] leading-[1.6] text-[#3f4944]"
          >
            Ik ben een creatieve en resultaatgerichte developer in opleiding.
            Ik krijg energie van problemen oplossen, samenwerken en ideeën
            omzetten in iets dat echt werkt.
          </p>

          <div class="mt-5 flex flex-wrap items-center gap-7">
            <a
              href="#profiel"
              class="bg-dark px-[18px] py-[14px] text-[14px] text-white no-underline transition-transform hover:-translate-y-0.5"
            >
              Ontdek mijn profiel <span aria-hidden="true">↓</span>
            </a>

            <a
              href="#contact"
              class="text-[14px] text-dark no-underline hover:underline"
            >
              Neem contact op <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <figure
          class="mb-0 h-[390px] w-full self-end overflow-hidden rounded-t-[150px] border-4 border-light shadow-[9px_9px_0_#ff6945] max-[900px]:h-[295px] max-[900px]:border-[3px] max-[900px]:shadow-[6px_6px_0_#ff6945] max-[560px]:h-[285px] max-[560px]:w-[210px] max-[560px]:justify-self-end"
        >
          <img
            src="/assets/ilker-ocak.jpeg"
            alt="Ilker Ocak"
            class="h-full w-full object-cover object-top"
          />
        </figure>

        <div
          class="col-span-full self-end text-[12px] text-gray max-[560px]:col-auto"
        >
          <span
            class="mr-[7px] inline-block h-[9px] w-[9px] rounded-full bg-orange align-middle"
            aria-hidden="true"
          ></span>
          Open voor leren, maken en samenwerken
        </div>
      </section>

      <!-- PROFIEL -->
      <section
        id="profiel"
        class="grid grid-cols-2 gap-[10%] border-b border-line px-[12%] py-[100px] max-[900px]:grid-cols-1 max-[900px]:gap-[35px] max-[900px]:px-5 max-[900px]:py-[65px]"
      >
        <div>
          <p
            class="mb-4 text-[12px] font-bold uppercase tracking-[1px] text-gray"
          >
            01 — Over mij
          </p>

          <h2
            class="mb-0 text-[clamp(36px,5vw,68px)] font-bold leading-none tracking-[-3px] max-[900px]:tracking-[-2px]"
          >
            Nieuwsgierig, creatief en gericht op resultaat.
          </h2>
        </div>

        <div class="text-[17px] leading-[1.7] text-[#3f4944]">
          <p>
            Ik ben Ilker Ocak, 22 jaar, geboren en getogen in Rotterdam.
            Momenteel studeer ik Software Development aan de Hogeschool
            Rotterdam.
          </p>

          <p>
            Ik vind het belangrijk dat werk zichtbaar resultaat oplevert.
            Daarom combineer ik graag creatief denken met een praktische
            aanpak: eerst goed begrijpen wat er nodig is, daarna iets maken
            dat waarde toevoegt.
          </p>

          <p class="mb-0">
            Ik werk prettig in een team waar ruimte is voor overleg en
            brainstormen. Tegelijkertijd kan ik mij zelfstandig goed
            concentreren en gefocust aan een taak werken.
          </p>
        </div>
      </section>

      <!-- STERKTES -->
      <section
        id="sterktes"
        class="border-b border-line px-[12%] py-[100px] max-[900px]:px-5 max-[900px]:py-[65px]"
      >
        <p
          class="mb-4 text-[12px] font-bold uppercase tracking-[1px] text-gray"
        >
          02 — Mijn sterke punten
        </p>

        <h2
          class="mb-0 text-[clamp(36px,5vw,68px)] font-bold leading-none tracking-[-3px] max-[900px]:tracking-[-2px]"
        >
          Wat ik meebreng.
        </h2>

        <div
          class="mt-[45px] grid grid-cols-3 border-t border-line max-[900px]:mt-[30px] max-[900px]:grid-cols-1"
        >
          {
            strengths.map((strength, index) => (
              <article
                class:list={[
                  "min-h-[220px] border-b border-r border-line p-[22px]",
                  (index + 1) % 3 === 0 && "border-r-0",
                  "max-[900px]:min-h-0 max-[900px]:border-r-0 max-[900px]:px-0 max-[900px]:py-4 max-[900px]:grid max-[900px]:grid-cols-[35px_150px_1fr] max-[900px]:gap-[10px] max-[900px]:items-start",
                  "max-[560px]:grid-cols-[28px_1fr] max-[560px]:gap-x-[10px] max-[560px]:gap-y-1",
                ]}
              >
                <span class="text-[12px] font-bold text-orange">
                  {strength.number}
                </span>

                <h3
                  class:list={[
                    "mt-[52px] mb-0 text-[20px] font-bold",
                    "max-[900px]:m-0",
                    "max-[560px]:m-0",
                  ]}
                >
                  {strength.title}
                </h3>

                <p
                  class:list={[
                    "mb-0 text-[15px] leading-[1.6] text-gray",
                    "max-[900px]:m-0",
                    "max-[560px]:col-start-2",
                  ]}
                >
                  {strength.text}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- WERKWIJZE -->
      <section
        class="grid grid-cols-2 gap-[10%] border-b border-line px-[12%] py-[100px] max-[900px]:grid-cols-1 max-[900px]:gap-[35px] max-[900px]:px-5 max-[900px]:py-[65px]"
      >
        <div>
          <p
            class="mb-4 text-[12px] font-bold uppercase tracking-[1px] text-gray"
          >
            03 — Zo werk ik graag
          </p>

          <h2
            class="mb-0 text-[clamp(36px,5vw,68px)] font-bold leading-none tracking-[-3px] max-[900px]:tracking-[-2px]"
          >
            Samen waar het helpt.<br />
            Zelfstandig waar het kan.
          </h2>
        </div>

        <div class="border-t border-dark">
          <div class="border-b border-line py-[17px]">
            <b class="mb-[5px] block text-[13px]">Team</b>
            <span class="block text-gray">
              Middelgroot team met veel samenwerking
            </span>
          </div>

          <div class="border-b border-line py-[17px]">
            <b class="mb-[5px] block text-[13px]">Werksfeer</b>
            <span class="block text-gray">
              Informeel, flexibel en prettig
            </span>
          </div>

          <div class="border-b border-line py-[17px]">
            <b class="mb-[5px] block text-[13px]">Beslissingen</b>
            <span class="block text-gray">
              Zorgvuldig, met aandacht voor kwaliteit
            </span>
          </div>

          <div class="border-b border-line py-[17px]">
            <b class="mb-[5px] block text-[13px]">Leren</b>
            <span class="block text-gray">
              Door te doen, met begeleiding uit de praktijk
            </span>
          </div>
        </div>
      </section>

      <!-- AMBITIE -->
      <section
        id="ambitie"
        class="grid grid-cols-[2fr_1fr] gap-[10%] border-b border-line bg-dark px-[12%] py-[100px] text-light max-[900px]:grid-cols-1 max-[900px]:gap-[35px] max-[900px]:px-5 max-[900px]:py-[65px]"
      >
        <div>
          <p
            class="mb-4 text-[12px] font-bold uppercase tracking-[1px] text-[#c9d0c7]"
